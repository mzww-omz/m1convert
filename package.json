{
	"name": "m1convert",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"test": "node --test tests/*.test.mjs",
		"test:browser": "node tests/browser.mjs",
		"test:categories": "node tests/categories-browser.mjs",
		"test:checking": "node tests/checking-browser.mjs",
		"test:phase4": "node tests/phase4-browser.mjs",
		"test:phase5": "node tests/phase5-browser.mjs",
		"test:phase6": "node tests/phase6-browser.mjs",
		"test:static": "node tests/static-build.mjs",
		"test:audio": "node tests/audio-browser.mjs && node tests/audio-lifecycle-browser.mjs",
		"sync:audio-assets": "node scripts/sync-audio-assets.mjs",
		"sync:png-assets": "node scripts/sync-png-assets.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@libav.js/types": "6.10.9",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@jsquash/png": "3.1.1",
		"@libav.js/variant-obsolete": "6.10.9",
		"mediabunny": "1.62.0"
	}
}
